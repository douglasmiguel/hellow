{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "ocean": {
      "950": { "$type": "color", "$value": "#031F29" },
      "900": { "$type": "color", "$value": "#052C39" },
      "800": { "$type": "color", "$value": "#06475C" },
      "700": { "$type": "color", "$value": "#006B87" }
    },
    "teal": {
      "500": { "$type": "color", "$value": "#00B8B8" }
    },
    "cyan": {
      "400": { "$type": "color", "$value": "#00DCE6" },
      "300": { "$type": "color", "$value": "#61F1F2" },
      "100": { "$type": "color", "$value": "#D8FFFF" }
    },
    "lime": {
      "400": { "$type": "color", "$value": "#C8FF00" },
      "300": { "$type": "color", "$value": "#DCFF66" }
    },
    "neutral": {
      "white": { "$type": "color", "$value": "#F7FFFE" }
    },
    "status": {
      "danger": { "$type": "color", "$value": "#FF9B86" }
    }
  },
  "gradient": {
    "brand": {
      "$type": "gradient",
      "$value": [
        { "color": "#006B87", "position": 0 },
        { "color": "#00DCE6", "position": 0.52 },
        { "color": "#C8FF00", "position": 1 }
      ]
    }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": { "value": 11, "unit": "px" } },
    "medium": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
    "round": { "$type": "dimension", "$value": { "value": 999, "unit": "px" } }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": { "value": 160, "unit": "ms" } },
    "panel": { "$type": "duration", "$value": { "value": 260, "unit": "ms" } }
  }
}
