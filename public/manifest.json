{
  "manifest_version": 3,
  "name": "Hellow Beta",
  "description": "A calm, private new tab with your clock, greeting, world clocks, and 20 beautiful background choices.",
  "version": "0.2.0",
  "version_name": "0.2.0-beta.1",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
