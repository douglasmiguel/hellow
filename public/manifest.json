{
  "manifest_version": 3,
  "name": "Hellow",
  "description": "A calm new tab with your clock, greeting, world clocks, currency conversions, and 100 beautiful background choices.",
  "version": "0.3.0",
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://api.frankfurter.dev/*"
  ]
}
